# Authorize.net SANDBOX credentials (https://developer.authorize.net/hello_world/sandbox.html)
# Never put production credentials here. This project only talks to the sandbox.
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
PORT=3000
# Public client key (Account > Settings > Manage Public Client Key). Used only by `yarn client`
# to fake the mobile app's tokenization step. Not secret.
AUTHNET_CLIENT_KEY=
